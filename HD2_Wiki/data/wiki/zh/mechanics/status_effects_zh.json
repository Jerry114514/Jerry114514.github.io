    {
      "id": "Acid_Splash",
      "title_zh": "酸液飞溅",
      "fully_translated": true,
      "content_zh": "<ul><li>被酸液覆盖的目标会被<strong>减速</strong>，并可能额外受到持续伤害。该效果持续 4 秒。</li><li>可由以下终结族敌人造成：吐酸虫、猎手、吐酸武斗虫、胆汁喷涌虫、抚育喷涌者、孢子强袭虫、吐酸泰坦、虫雷、掠食追猎虫，以及全部孢裂虫株（Spore Burst Strain）终结族。</li></ul>",
      "tables_zh": [
        {
          "html": "<table class=\"wikitable tableleftjustified Secondcolumnright table-weapon-stats attack-data-table-status\">\n<tbody><tr>\n<th colspan=\"2\">酸液飞溅</th></tr>\n<tr>\n<th colspan=\"2\">状态</th></tr>\n<tr>\n<td>状态持续时间</td>\n<td>4 秒</td></tr>\n<tr>\n<th colspan=\"2\">伤害</th></tr>\n<tr>\n<td>元素</td>\n<td>酸液</td></tr>\n<tr>\n<td>标准伤害</td>\n<td><span class=\"DamageIcons icon-outline\"><a href=\"/wiki/Damage\" title=\"Damage\"><img alt=\"\" src=\"./assets/mechanics/status_effects/Damage_Acid_Icon.svg\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" data-file-width=\"512\" data-file-height=\"512\" /></a></span>&#160;<span class=\"DamageIcons\"><a href=\"/wiki/Damage#Damage_Types\" title=\"Damage\"><span style=\"color: chartreuse;\">3 酸液</span></a></span>\n</td></tr>\n<tr>\n<td>耐久伤害</td>\n<td><span class=\"DamageIcons icon-outline\"><a href=\"/wiki/Damage\" title=\"Damage\"><img alt=\"\" src=\"./assets/mechanics/status_effects/Damage_Acid_Icon.svg\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" data-file-width=\"512\" data-file-height=\"512\" /></a></span>&#160;<span class=\"DamageIcons\"><a href=\"/wiki/Damage#Damage_Types\" title=\"Damage\"><span style=\"color: chartreuse;\">0 酸液</span></a></span>\n</td></tr>\n<tr>\n<th colspan=\"2\">穿透</th></tr>\n<tr>\n<td>直射穿透</td>\n<td><span class=\"Templateicons icon-outline\"><a href=\"/wiki/Damage#Armor_Penetration_&amp;_Armor_Values\" title=\"Damage\"><img alt=\"\" src=\"./assets/mechanics/status_effects/Armor_AP1_Icon.png\" decoding=\"async\" loading=\"lazy\" width=\"188\" height=\"221\" data-file-width=\"188\" data-file-height=\"221\" /></a>&#160;<a href=\"/wiki/Damage#Armor_Penetration_&amp;_Armor_Values\" title=\"Damage\">极轻甲</a></span>\n</td></tr>\n<tr>\n<td>小角度穿透</td>\n<td><span class=\"Templateicons icon-outline\"><a href=\"/wiki/Damage#Armor_Penetration_&amp;_Armor_Values\" title=\"Damage\"><img alt=\"\" src=\"./assets/mechanics/status_effects/Armor_AP1_Icon.png\" decoding=\"async\" loading=\"lazy\" width=\"188\" height=\"221\" data-file-width=\"188\" data-file-height=\"221\" /></a>&#160;<a href=\"/wiki/Damage#Armor_Penetration_&amp;_Armor_Values\" title=\"Damage\">极轻甲</a></span>\n</td></tr>\n<tr>\n<td>大角度穿透</td>\n<td><span class=\"Templateicons icon-outline\"><a href=\"/wiki/Damage#Armor_Penetration_&amp;_Armor_Values\" title=\"Damage\"><img alt=\"\" src=\"./assets/mechanics/status_effects/Armor_AP1_Icon.png\" decoding=\"async\" loading=\"lazy\" width=\"188\" height=\"221\" data-file-width=\"188\" data-file-height=\"221\" /></a>&#160;<a href=\"/wiki/Damage#Armor_Penetration_&amp;_Armor_Values\" title=\"Damage\">极轻甲</a></span>\n</td></tr>\n<tr>\n<td>极端角度穿透</td>\n<td><span class=\"Templateicons icon-outline\"><a href=\"/wiki/Damage#Armor_Penetration_&amp;_Armor_Values\" title=\"Damage\"><img alt=\"\" src=\"./assets/mechanics/status_effects/Armor_AP0_Icon.png\" decoding=\"async\" loading=\"lazy\" width=\"188\" height=\"221\" data-file-width=\"188\" data-file-height=\"221\" /></a>&#160;<a href=\"/wiki/Damage#Armor_Penetration_&amp;_Armor_Values\" title=\"Damage\">无护甲</a></span>\n</td></tr>\n<tr>\n<th colspan=\"2\">特殊效果</th></tr>\n<tr>\n<td>拆毁值</td>\n<td>0\n</td></tr>\n<tr>\n<td>踉跄力</td>\n<td>0\n</td></tr>\n<tr>\n<td>推力</td>\n<td>0\n</td></tr>\n</tbody></table>"
        }
