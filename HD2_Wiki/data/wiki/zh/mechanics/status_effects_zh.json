              "html": "<table class=\"wikitable sortable mw-collapsible mw-collapsed\">\n\n<caption>踉跄阈值表</caption>\n<tbody><tr>\n<th>阵营</th>\n<th>敌人</th>\n<th>踉跄阈值</th></tr>\n<tr>\n<th rowspan=\"28\"><span class=\"faction-icon icon-outline\"><a href=\"/wiki/Terminids\" title=\"Terminids\"><img alt=\"\" src=\"./assets/mechanics/status_effects/Terminid_Icon.svg\" decoding=\"async\" loading=\"lazy\" width=\"512\" height=\"512\" data-file-width=\"512\" data-file-height=\"512\" /></a>&#160;<a href=\"/wiki/Terminids\" title=\"Terminids\">终结族群</a></span>\n</th>\n<td><a href=\"/wiki/Bile_Spitter\" title=\"Bile Spitter\">吐酸虫</a></td>\n<td>1\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Pouncer\" title=\"Pouncer\">猛扑虫</a></td>\n<td>1\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Scavenger\" title=\"Scavenger\">食腐虫</a></td>\n<td>1\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Spore_Burst_Scavenger\" title=\"Spore Burst Scavenger\">孢裂食腐虫</a></td>\n<td>1\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Hunter\" title=\"Hunter\">猎手</a></td>\n<td>15\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Predator_Hunter\" title=\"Predator Hunter\">掠食追猎虫</a></td>\n<td>15\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Spore_Burst_Hunter\" title=\"Spore Burst Hunter\">孢裂追猎虫</a></td>\n<td>15\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Alpha_Warrior\" title=\"Alpha Warrior\">阿尔法武斗虫</a></td>\n<td>20\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Bile_Warrior\" title=\"Bile Warrior\">吐酸武斗虫</a></td>\n<td>20\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Hive_Guard\" title=\"Hive Guard\">虫巢守卫</a></td>\n<td>20\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Rupture_Warrior\" title=\"Rupture Warrior\">爆裂武斗虫</a></td>\n<td>20\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Spore_Burst_Warrior\" title=\"Spore Burst Warrior\">孢裂武斗虫</a></td>\n<td>20\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Warrior\" title=\"Warrior\">武斗虫</a></td>\n<td>20\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Alpha_Commander\" title=\"Alpha Commander\">阿尔法指挥官</a></td>\n<td>25\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Brood_Com